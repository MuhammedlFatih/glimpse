{
  "manifest_version": 3,
  "name": "Glimpse",
  "version": "1.0.0",
  "description": "Watch and learn. Instantly look up any word or concept while watching YouTube.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "*://api.dictionaryapi.dev/*",
    "*://en.wikipedia.org/*"
  ]
}
